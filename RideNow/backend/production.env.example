# ==============================================================================
# RIDENOW — PRODUCTION ENVIRONMENT REFERENCE TEMPLATE
# ==============================================================================
# This template documents all environment variables required for production.
#
# IMPORTANT DEPLOYMENT NOTE FOR RENDER:
# In Render (https://dashboard.render.com), do NOT upload this file.
# Instead, add these variables directly in the Render Dashboard under:
#   Your Web Service > "Environment" tab > "Add Environment Variable".
#
# Render automatically injects dashboard environment variables into the process
# environment (os.environ), which takes precedence over any file.
#
# ALL SECRET VALUES ARE INTENTIONALLY LEFT EMPTY IN THIS TEMPLATE.
# ==============================================================================

# ── Deployment Mode ───────────────────────────────────────────────────────────
# Must be "production".
# When set to production, RideNow automatically:
#   - Disables SQL query echoing in logs
#   - Restricts CORS (disables localhost development regex)
ENVIRONMENT=production

# ── Core Database (Supabase PostgreSQL via Session Pooler) ─────────────────────
# Format: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?ssl=require
# Note: Ensure the driver is "postgresql+asyncpg://" and port is 5432.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used for signing HS256 JWT tokens. Must be a strong 32+ character random secret.
# Generate on your machine: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of your exact production frontend URL(s).
# Example: https://ridenow.vercel.app
# Do NOT include trailing slashes.
CORS_ORIGINS=

# ── Redis Cache & Rate-Limiting (Upstash Redis) ───────────────────────────────
# Upstash TLS connection URL.
# Format: rediss://default:[TOKEN]@[ENDPOINT]:6379
# If unset, the application falls back to temporary in-memory storage.
REDIS_URL=
REDIS_CHAT_TTL_SECONDS=3600
REDIS_RATE_LIMIT_REQUESTS=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# ── AI / LLM Provider (Groq) ──────────────────────────────────────────────────
# Primary provider for RideNow AI Copilot, Chat Agent, and Operational Intelligence.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_TIMEOUT_SECONDS=30.0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── LiveKit Real-Time Voice WebRTC ────────────────────────────────────────────
# Credentials for LiveKit Cloud voice assistant worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_MINUTES=60

# ── Cartesia Neural Voice STT / TTS ───────────────────────────────────────────
# Neural text-to-speech and speech-to-text credentials.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3
CARTESIA_STT_MODEL=ink-whisper

# ── Knowledge Base (ChromaDB) ─────────────────────────────────────────────────
CHROMA_COLLECTION_NAME=ridenow_knowledge
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# ── Feature Flags ─────────────────────────────────────────────────────────────
AI_CHAT_ENABLED=true
WEBSOCKET_ENABLED=true
RAG_ENABLED=true

# ── Process & Concurrency (Gunicorn / Render) ─────────────────────────────────
# Render sets PORT automatically (defaults to 10000 on Render).
WEB_CONCURRENCY=2
LOG_LEVEL=info
