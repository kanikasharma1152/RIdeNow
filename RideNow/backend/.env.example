# ==============================================================================
# RIDENOW — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real credentials.
#
# Production / Supabase Database URL:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/ridenow_db

# ── Deployment Environment ────────────────────────────────────────────────────
# Options: development | staging | production
# Controls: echo SQL (dev only), CORS localhost regex (dev only), log verbosity
ENVIRONMENT=development

# ── Database Connection Pool ───────────────────────────────────────────────────
# Tune for your server: pool_size = persistent connections per worker
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used for signing HS256 JWT tokens. Generate a 32+ character random string.
SECRET_KEY=change-this-in-production-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS Settings ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── Google OAuth 2.0 (Phase 2) ────────────────────────────────────────────────
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project named "RideNow Mobility"
# 3. Navigate to APIs & Services > Credentials
# 4. Configure OAuth Consent Screen (User Type: External, App Name: RideNow)
# 5. Create Credentials > OAuth client ID > Web application
#    - Authorized JavaScript origins: http://localhost:5173 (and your production domain)
#    - Authorized redirect URIs: http://localhost:5173
# 6. Copy the Client ID and Client Secret into the variables below:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# ── Redis Cache & Pub/Sub ─────────────────────────────────────────────────────
# If not configured, RideNow automatically falls back to safe in-memory cache/locks.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=
REDIS_CHAT_TTL_SECONDS=3600
REDIS_RATE_LIMIT_REQUESTS=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60

# ── LLM Inference Provider (Groq) ─────────────────────────────────────────────
# Primary provider for AI Copilot, Chat Agent, and Operational Analytics
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your-groq-api-key-here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── LiveKit Real-Time WebRTC Voice ────────────────────────────────────────────
# Used by the LiveKit voice agent worker
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_MINUTES=60

# ── Cartesia Neural Voice STT / TTS ───────────────────────────────────────────
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=f786b574-daa5-4673-aa0c-cbe3e8534c02
CARTESIA_MODEL=sonic-3
CARTESIA_STT_MODEL=ink-whisper

# ── Local ChromaDB RAG Vector Store ───────────────────────────────────────────
CHROMA_COLLECTION_NAME=ridenow_knowledge
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# ── Feature Flags ─────────────────────────────────────────────────────────────
AI_CHAT_ENABLED=true
WEBSOCKET_ENABLED=true
RAG_ENABLED=true
