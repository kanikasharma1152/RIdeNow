# ==============================================================================
# RIDENOW — FRONTEND ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env in your frontend directory.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER place backend secrets, JWT private keys, or DB credentials in this file.

# ── API Base URL ─────────────────────────────────────────────────────────────
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production example:
# VITE_API_BASE_URL=https://api.ridenow.example.com

# ── WebSocket Gateway URL (Optional) ──────────────────────────────────────────
# If omitted, the frontend automatically derives the WebSocket URL from VITE_API_BASE_URL
# Local development:
VITE_WS_URL=ws://localhost:8000/ws
# Production example (WSS):
# VITE_WS_URL=wss://api.ridenow.example.com/ws
